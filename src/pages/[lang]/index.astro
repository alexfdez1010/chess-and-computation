---
import BookLayout from '../../layouts/BookLayout.astro';
import { chaptersFor, copy, navigationGroupsFor, type Language } from '../../components/content';

export function getStaticPaths() {
  return ['es', 'en'].map((lang) => ({ params: { lang }, props: { lang: lang as Language } }));
}
const { lang } = Astro.props as { lang: Language };
const text = copy[lang];
const entries = chaptersFor(lang);
const first = entries[0];
const outline = navigationGroupsFor(lang);
const groupNumber = (key: string) => key === '0' ? '' : /^\d$/.test(key) ? key.padStart(2, '0') : key === 'references' ? '—' : key;
---
<BookLayout {lang} alternatePath={`/${lang === 'es' ? 'en' : 'es'}`}>
  <div class="home-page">
    <section class="home-hero">
      <div class="hero-copy">
        <p class="edition-label">{lang === 'es' ? 'Edición web · 2026' : 'Web edition · 2026'}</p>
        <h1>{text.title}</h1>
        <p class="hero-subtitle">{text.subtitle}</p>
        <p class="hero-description">{text.description}</p>
        <div class="hero-actions">
          {first && <a class="primary-link" href={`/${lang}/${first.slug}`}>{text.start}<span aria-hidden="true">→</span></a>}
          <a class="secondary-link" href="https://www.amazon.es/Ajedrez-Computación-movimientos-revolución-ajedrez/dp/B0CNCT6DZ1" rel="sponsored noopener noreferrer" target="_blank">
            {lang === 'es' ? 'Comprar el libro' : 'Buy the book'}<span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <picture class="hero-media">
        <source type="image/webp" srcset="/assets/hero/chess-pieces-editorial-720.webp 720w, /assets/hero/chess-pieces-editorial-1200.webp 1200w" sizes="(max-width: 900px) 92vw, 44vw" />
        <img src="/assets/hero/chess-pieces-editorial.png" width="1200" height="800" alt={lang === 'es' ? 'Composición editorial de un caballo negro, una dama blanca y una torre verde' : 'Editorial composition of a black knight, a white queen, and a green rook'} loading="eager" decoding="async" fetchpriority="high" />
      </picture>
    </section>

    <section class="thesis-strip" aria-label={lang === 'es' ? 'Temas principales' : 'Main themes'}>
      <span>{lang === 'es' ? 'Algoritmos' : 'Algorithms'}</span><i></i>
      <span>{lang === 'es' ? 'Búsqueda' : 'Search'}</span><i></i>
      <span>{lang === 'es' ? 'Aprendizaje' : 'Learning'}</span><i></i>
      <span>{lang === 'es' ? 'Estrategia' : 'Strategy'}</span>
    </section>

    <section class="contents-preview">
      <div>
        <h2>{lang === 'es' ? 'Ideas que transformaron el juego' : 'Ideas that transformed the game'}</h2>
        <p>{lang === 'es' ? 'Una lectura progresiva, desde la representación del tablero hasta las redes neuronales modernas.' : 'A progressive reading, from board representation to modern neural networks.'}</p>
      </div>
      <ol class="home-outline">
        {outline.map((group) => (
          <li class="outline-group">
            {group.landing ? <a class="outline-heading" href={`/${lang}/${group.landing.slug}`}>
              <span>{groupNumber(group.key)}</span><strong>{group.title}</strong><b aria-hidden="true">↗</b>
            </a> : <div class="outline-heading"><span>{groupNumber(group.key)}</span><strong>{group.title}</strong></div>}
            {group.sections.length > 0 && <ol>
              {group.sections.map((entry) => <li><a href={`/${lang}/${entry.slug}`}>
                <span>{entry.sectionNumber}</span><strong>{entry.sectionTitle || entry.title}</strong><small>{entry.description}</small><b aria-hidden="true">↗</b>
              </a></li>)}
            </ol>}
          </li>
        ))}
      </ol>
      {first && <a class="text-link" href={`/${lang}/${first.slug}`}>{text.start} →</a>}
    </section>
  </div>
</BookLayout>
