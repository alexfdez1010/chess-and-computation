---
import type { Language } from './content';
const { lang } = Astro.props as { lang: Language };
---
<script is:inline define:vars={{ pageLanguage: lang }}>
  const pieceGlyphs = { k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟', K: '♔', Q: '♕', R: '♖', B: '♗', N: '♘', P: '♙' };
  const pieceNames = {
    es: { k: 'rey negro', q: 'dama negra', r: 'torre negra', b: 'alfil negro', n: 'caballo negro', p: 'peón negro', K: 'rey blanco', Q: 'dama blanca', R: 'torre blanca', B: 'alfil blanco', N: 'caballo blanco', P: 'peón blanco' },
    en: { k: 'black king', q: 'black queen', r: 'black rook', b: 'black bishop', n: 'black knight', p: 'black pawn', K: 'white king', Q: 'white queen', R: 'white rook', B: 'white bishop', N: 'white knight', P: 'white pawn' },
  };
  const startPieces = ['ra8','nb8','bc8','qd8','ke8','bf8','ng8','rh8','pa7','pb7','pc7','pd7','pe7','pf7','pg7','ph7','Pa2','Pb2','Pc2','Pd2','Pe2','Pf2','Pg2','Ph2','Ra1','Nb1','Bc1','Qd1','Ke1','Bf1','Ng1','Rh1'];
  const fenPieces = (fen, size) => {
    const placement = (fen || '').split(/\s+/)[0];
    if (!placement.includes('/')) return [];
    const rows = placement.split('/');
    const pieces = [];
    rows.slice(0, size).forEach((row, rowIndex) => {
      let file = 0;
      for (let index = 0; index < row.length && file < size; index++) {
        const token = row[index];
        if (/\d/.test(token)) {
          let digits = token;
          while (/\d/.test(row[index + 1] || '')) digits += row[++index];
          file += Number(digits);
        } else if (pieceGlyphs[token]) {
          pieces.push(`${token}${String.fromCharCode(97 + file)}${size - rowIndex}`);
          file++;
        } else file++;
      }
    });
    return pieces;
  };

  const parseSquare = (square, size) => {
    const match = square.match(/^([a-j])(10|[1-9])$/i);
    if (!match) return null;
    const file = match[1].toLowerCase().charCodeAt(0) - 97;
    const rank = Number(match[2]);
    if (file >= size || rank > size) return null;
    return { file, rank, x: (file + .5) * 100 / size, y: (size - rank + .5) * 100 / size };
  };

  document.querySelectorAll('.chessboard').forEach((board) => {
    if (board.dataset.rendered) return;
    const size = Math.min(10, Math.max(1, Number(board.dataset.size) || 8));
    const orientation = board.dataset.orientation === 'black' ? 'black' : 'white';
    const visual = document.createElement('div');
    visual.className = 'chessboard-grid';
    visual.style.setProperty('--board-size', size);
    visual.setAttribute('role', 'grid');
    const descriptions = [];
    for (let row = 0; row < size; row++) {
      for (let column = 0; column < size; column++) {
        const file = orientation === 'white' ? column : size - column - 1;
        const rank = orientation === 'white' ? size - row : row + 1;
        const square = `${String.fromCharCode(97 + file)}${rank}`;
        const cell = document.createElement('span');
        cell.className = 'chess-square';
        cell.dataset.square = square;
        cell.setAttribute('role', 'gridcell');
        cell.setAttribute('aria-label', square);
        if ((file + rank) % 2 === 1) cell.classList.add('is-dark');
        if ((orientation === 'white' ? row === size - 1 : row === 0)) cell.dataset.file = String.fromCharCode(97 + file);
        if ((orientation === 'white' ? column === 0 : column === size - 1)) cell.dataset.rank = String(rank);
        visual.append(cell);
      }
    }
    const declaredPieces = (board.dataset.pieces || '').split(',').map((value) => value.trim()).filter(Boolean);
    const rawPieces = declaredPieces.length ? declaredPieces : (board.dataset.fen === 'start' ? startPieces : fenPieces(board.dataset.fen, size));
    rawPieces.forEach((notation) => {
      const match = notation.match(/^([kqrbnpKQRBNP])([a-j](?:10|[1-9]))$/);
      if (!match) return;
      const cell = visual.querySelector(`[data-square="${match[2]}"]`);
      if (!cell) return;
      const piece = document.createElement('b');
      piece.className = 'chess-piece';
      piece.textContent = pieceGlyphs[match[1]];
      piece.setAttribute('aria-label', pieceNames[pageLanguage][match[1]]);
      cell.append(piece);
      descriptions.push(`${pieceNames[pageLanguage][match[1]]} ${pageLanguage === 'es' ? 'en' : 'on'} ${match[2]}`);
    });
    try {
      const labels = JSON.parse(board.dataset.labels || '{}');
      Object.entries(labels).forEach(([square, value]) => {
        const cell = visual.querySelector(`[data-square="${square}"]`);
        if (!cell) return;
        const label = document.createElement('b');
        label.className = 'square-value';
        if (cell.querySelector('.chess-piece')) label.classList.add('shares-square-with-piece');
        label.textContent = String(value);
        label.setAttribute('aria-label', `${square}: ${value}`);
        cell.append(label);
        descriptions.push(`${square}: ${value}`);
      });
    } catch { /* Invalid optional labels do not prevent the board rendering. */ }
    (board.dataset.marks || '').split(',').map((value) => value.trim().split(/-|:|>/)[0]).filter(Boolean).forEach((square) => visual.querySelector(`[data-square="${square}"]`)?.classList.add('is-marked'));
    const arrows = document.createElement('div');
    arrows.className = 'board-arrows';
    (board.dataset.arrows || '').split(',').map((value) => value.trim()).filter(Boolean).forEach((arrow) => {
      const match = arrow.match(/^([a-j](?:10|[1-9]))(?:-|:|>)([a-j](?:10|[1-9]))$/i);
      if (!match) return;
      const start = parseSquare(match[1], size); const end = parseSquare(match[2], size);
      if (!start || !end) return;
      const line = document.createElement('i');
      const dx = end.x - start.x; const dy = end.y - start.y;
      line.style.left = `${start.x}%`; line.style.top = `${start.y}%`;
      line.style.width = `${Math.hypot(dx, dy)}%`; line.style.transform = `rotate(${Math.atan2(dy, dx)}rad)`;
      arrows.append(line);
    });
    visual.append(arrows);
    board.replaceChildren(visual);
    board.dataset.rendered = 'true';
    board.setAttribute('role', 'img');
    board.setAttribute('aria-label', board.getAttribute('aria-label') || `${pageLanguage === 'es' ? 'Tablero de ajedrez' : 'Chessboard'}. ${descriptions.join(', ')}`);
  });

  const labels = {
    es: {
      input: 'Entrada', hidden: 'Capas ocultas', policy: 'Política', value: 'Valor', output: 'Salida',
      state: 'Estado', agent: 'Agente', action: 'Acción', environment: 'Entorno', reward: 'Recompensa',
      select: 'Seleccionar', expand: 'Expandir', evaluate: 'Evaluar', backup: 'Propagar', root: 'Raíz', move: 'Jugada',
      board: 'Tablero', planes: 'Planos de características', residual: 'Bloque residual', games: 'Partidas', solutions: 'Soluciones', queens: 'Número de reinas',
    },
    en: {
      input: 'Input', hidden: 'Hidden layers', policy: 'Policy', value: 'Value', output: 'Output',
      state: 'State', agent: 'Agent', action: 'Action', environment: 'Environment', reward: 'Reward',
      select: 'Select', expand: 'Expand', evaluate: 'Evaluate', backup: 'Backup', root: 'Root', move: 'Move',
      board: 'Board', planes: 'Feature planes', residual: 'Residual block', games: 'Games', solutions: 'Solutions', queens: 'Number of queens',
    },
  }[pageLanguage];
  const node = (text, className = '') => `<span class="diagram-node ${className}">${text}</span>`;
  const arrow = '<i class="diagram-arrow" aria-hidden="true">→</i>';
  const isSpanish = pageLanguage === 'es';
  const mctsNode = (id, n, w, p) => `${id}["N=${n}<br/>W=${w}<br/>P=${p}"]`;
  const flowAriaLabels = isSpanish ? {
    'game-tree': 'Ejemplo de árbol de juego',
    'game-path-1': 'Primera variante del árbol de juego',
    'game-path-2': 'Segunda variante del árbol de juego',
    'alpha-beta': 'Ejemplo de poda alfa-beta aplicado al ajedrez usando orden derecha-izquierda',
    'alphazero-network': 'Red neuronal de AlphaZero',
    'alphazero-residual': 'Estructura de un bloque residual en AlphaZero',
    'alphazero-directions': 'Asignación de valores a las direcciones de los movimientos de dama',
    'mcts-initial': 'Estado del árbol MCTS antes de realizar la última simulación',
    'mcts-final': 'Estado del árbol MCTS después de finalizar la última simulación',
  } : {
    'game-tree': 'Game tree example',
    'game-path-1': 'First game-tree variation',
    'game-path-2': 'Second game-tree variation',
    'alpha-beta': 'Example of alpha-beta pruning applied to chess using right-to-left order',
    'alphazero-network': 'AlphaZero neural network',
    'alphazero-residual': 'Structure of a residual block in AlphaZero',
    'alphazero-directions': 'Assignment of values to the directions of queen movements',
    'mcts-initial': 'State of the MCTS tree before performing the last simulation',
    'mcts-final': 'State of the MCTS tree after finishing the last simulation',
  };
  const flowDefinitions = {
    'game-tree': {
      nodes: 6,
      source: `flowchart TD
        p1((P1)) -->|"${isSpanish ? 'Dc4' : 'Qc4'}"| p2((P2))
        p1 -->|"${isSpanish ? 'Dg8' : 'Qg8'}"| p3((P3))
        p1 -->|"${isSpanish ? 'Rg2' : 'Kg2'}"| p4((P4))
        p3 -->|"${isSpanish ? 'Rxg8' : 'Kxg8'}"| p5((P5))
        p5 -->|"${isSpanish ? 'Cf7#' : 'Nf7#'}"| p6((P6))`,
    },
    'game-path-1': {
      nodes: 6,
      source: `flowchart TD
        p1((P1)) -->|"d4"| p5((P5))
        p1 -->|"d4"| p2((P2))
        p2 -->|"${isSpanish ? 'Cf6' : 'Nf6'}"| p6((P6))
        p2 -->|"d5"| p3((P3))
        p3 -->|"c4"| p4((P4))`,
    },
    'game-path-2': {
      nodes: 4,
      source: `flowchart TD
        p7((P7)) -->|"${isSpanish ? 'Cf3' : 'Nf3'}"| p8((P8))
        p8 -->|"${isSpanish ? 'Cf6' : 'Nf6'}"| p9((P9))
        p9 -->|"${isSpanish ? 'Cg1' : 'Ng1'}"| p10((P10))
        p10 -->|"${isSpanish ? 'Cg8' : 'Ng8'}"| p7`,
    },
    'alpha-beta': {
      nodes: 12,
      source: `flowchart TD
        subgraph max0["${isSpanish ? 'Máx 0' : 'Max 0'}"]
          p01((P01))
        end
        subgraph min1["${isSpanish ? 'Mín 1' : 'Min 1'}"]
          p02((P02))
          p03((P03))
          p04((P04))
        end
        subgraph max2["${isSpanish ? 'Máx 2' : 'Max 2'}"]
          p05((P05))
          p06((P06))
          p07((P07))
          p08((P08))
          p09((P09))
        end
        subgraph min3["${isSpanish ? 'Mín 3' : 'Min 3'}"]
          p10((P10))
          p11((P11))
          p12((P12))
        end
        p01 -->|"c4"| p02
        p01 -->|"${isSpanish ? 'Cf3' : 'Nf3'}"| p03
        p01 -->|"${isSpanish ? 'Af4' : 'Bf4'}"| p04
        p02 -.-> p05
        p02 -->|"e6"| p06
        p03 -->|"${isSpanish ? 'Ag4' : 'Bg4'}"| p07
        p04 -->|"${isSpanish ? 'Af5' : 'Bf5'}"| p08
        p04 -->|"${isSpanish ? 'Cf6' : 'Nf6'}"| p09
        p05 -->|"${isSpanish ? 'Cc3' : 'Nc3'}"| p10
        p05 -->|"${isSpanish ? 'Cf3' : 'Nf3'}"| p11
        p06 -->|"cxd5"| p12`,
    },
    'alphazero-network': {
      nodes: 6,
      source: `flowchart BT
        position["${isSpanish ? 'Posición' : 'Position'}"] --> features(("${isSpanish ? 'Extractor de<br/>características' : 'Feature<br/>extractor'}"))
        subgraph network["${isSpanish ? 'Red neuronal' : 'Neural network'}"]
          features
          policy(("${isSpanish ? 'Política' : 'Policy'}"))
          value(("${isSpanish ? 'Valor' : 'Value'}"))
          features --> policy
          features --> value
        end
        policy --> policyOutput["${isSpanish ? 'Salida de<br/>la política' : 'Policy<br/>output'}"]
        value --> valueOutput["${isSpanish ? 'Salida<br/>del valor' : 'Value<br/>output'}"]`,
    },
    'alphazero-residual': {
      nodes: 9,
      source: `flowchart LR
        input["${isSpanish ? 'Entrada' : 'Input'}"] --> convolution1(("${isSpanish ? 'Convolución' : 'Convolution'}"))
        convolution1 --> batch1(("${isSpanish ? 'Normalización<br/>de batch' : 'Batch<br/>normalization'}"))
        batch1 --> relu1((ReLU))
        relu1 --> convolution2(("${isSpanish ? 'Convolución' : 'Convolution'}"))
        convolution2 --> batch2(("${isSpanish ? 'Normalización<br/>de batch' : 'Batch<br/>normalization'}"))
        batch2 --> add((+))
        add --> relu2((ReLU))
        relu2 --> output["${isSpanish ? 'Salida' : 'Output'}"]
        input --> add`,
    },
    'alphazero-directions': {
      nodes: 9,
      source: `flowchart TB
        center((·))
        center --> northwest["${isSpanish ? 'NO: 1' : 'NW: 1'}"]
        center --> north["N: 0"]
        center --> northeast["NE: 1"]
        center --> west["${isSpanish ? 'O: 6' : 'W: 6'}"]
        center --> east["E: 2"]
        center --> southwest["${isSpanish ? 'SO: 5' : 'SW: 5'}"]
        center --> south["S: 4"]
        center --> southeast["SE: 3"]`,
    },
    'mcts-initial': {
      nodes: 7,
      source: `flowchart TD
        ${mctsNode('root', '140', '-3', isSpanish ? '1,000' : '1.000')}
        ${mctsNode('rf3', '100', '4', isSpanish ? '0,625' : '0.625')}
        ${mctsNode('b3', '10', '-4', isSpanish ? '0,125' : '0.125')}
        ${mctsNode('db3', '30', '-3', isSpanish ? '0,250' : '0.250')}
        ${mctsNode('f5a', '90', '-3', isSpanish ? '0,875' : '0.875')}
        ${mctsNode('ce7', '10', '-1', isSpanish ? '0,125' : '0.125')}
        ${mctsNode('f5b', '10', '-4', isSpanish ? '1,000' : '1.000')}
        root -->|"${isSpanish ? 'Rf3' : 'Kf3'}"| rf3
        root -->|"b3"| b3
        root -->|"${isSpanish ? 'Db3' : 'Qb3'}"| db3
        rf3 -->|"f5"| f5a
        rf3 -->|"${isSpanish ? 'Ce7' : 'Ne7'}"| ce7
        b3 -->|"f5"| f5b`,
    },
    'mcts-final': {
      nodes: 7,
      source: `flowchart TD
        ${mctsNode('root', '141', isSpanish ? '-2,4' : '-2.4', isSpanish ? '1,000' : '1.000')}
        ${mctsNode('rf3', '101', isSpanish ? '4,6' : '4.6', isSpanish ? '0,625' : '0.625')}
        ${mctsNode('b3', '10', '-4', isSpanish ? '0,125' : '0.125')}
        ${mctsNode('db3', '30', '-3', isSpanish ? '0,250' : '0.250')}
        ${mctsNode('f5a', '91', isSpanish ? '-3,6' : '-3.6', isSpanish ? '0,875' : '0.875')}
        ${mctsNode('ce7', '10', '-1', isSpanish ? '0,125' : '0.125')}
        ${mctsNode('f5b', '10', '-4', isSpanish ? '1,000' : '1.000')}
        root -->|"${isSpanish ? 'Rf3' : 'Kf3'}"| rf3
        root -->|"b3"| b3
        root -->|"${isSpanish ? 'Db3' : 'Qb3'}"| db3
        rf3 -->|"f5"| f5a
        rf3 -->|"${isSpanish ? 'Ce7' : 'Ne7'}"| ce7
        b3 -->|"f5"| f5b`,
    },
  };
  const templates = {
    cover: `<div class="cover-diagram"><div class="cover-mini-board">${Array.from({ length: 16 }, (_, i) => `<i class="${(Math.floor(i/4)+i)%2 ? 'dark' : ''}"></i>`).join('')}<b>♞</b></div><p>64<sup>+</sup></p></div>`,
    'n-queens': `<div class="bar-chart">${[1,0,0,2,10,4,40,92].map((value, i) => `<span style="--value:${Math.max(2,value)}"><i>${value}</i><b>${i+1}</b></span>`).join('')}</div><div class="diagram-legend"><span>${labels.queens}</span><span>${labels.solutions}</span></div>`,
    definition: `<div class="diagram-cycle">${node(labels.state)}${arrow}${node(labels.agent,'accent')}${arrow}${node(labels.action)}${arrow}${node(labels.environment,'wide')}${arrow}${node(labels.reward)}</div>`,
    'agent-environment': `<div class="diagram-cycle">${node(labels.agent,'accent')}${arrow}${node(labels.action)}${arrow}${node(labels.environment,'wide')}${arrow}${node(labels.state)}${arrow}${node(labels.reward)}</div>`,
    'alphazero-network': `<div class="network-diagram">${node(labels.board)}${arrow}${node('8 × 8 × 119','wide')}${arrow}${node(labels.residual,'accent wide')}${arrow}<span class="network-fork">${node(labels.policy)}${node(labels.value)}</span></div>`,
    'alphazero-residual': `<div class="residual-diagram">${node('x','accent')}${arrow}${node('Conv 3×3')}${arrow}${node('BN + ReLU')}${arrow}${node('Conv 3×3')}<i class="skip-line"></i>${arrow}${node('x + F(x)','accent')}</div>`,
    'alphazero-directions': `<div class="direction-diagram"><div class="direction-board"><b>♞</b>${['↖','↑','↗','←','→','↙','↓','↘'].map((d) => `<i>${d}</i>`).join('')}</div><p>8 × 8 × 73</p></div>`,
    'mcts-initial': `<div class="tree-diagram"><span class="tree-root">${labels.root}</span><div>${[1,2,3].map((i) => `<span>${labels.move} ${i}</span>`).join('')}</div></div><div class="diagram-steps"><b>${labels.select}</b><b>${labels.expand}</b></div>`,
    'mcts-final': `<div class="tree-diagram expanded"><span class="tree-root">N = 800</span><div>${['N=412','N=267','N=121'].map((v) => `<span>${v}</span>`).join('')}</div></div><div class="diagram-steps"><b>${labels.evaluate}</b><b>${labels.backup}</b></div>`,
    'game-tree': `<div class="tree-diagram expanded"><span class="tree-root">${labels.state}</span><div>${[1,2,3].map((i) => `<span>${labels.move} ${i}<small>${i === 2 ? '+1' : i === 1 ? '0' : '−1'}</small></span>`).join('')}</div></div>`,
    'alpha-beta': `<div class="tree-diagram pruned"><span class="tree-root">MAX</span><div><span>3</span><span class="prune">β ≤ α</span><span>5</span></div></div>`,
  };
  document.querySelectorAll('.localized-diagram[data-diagram]').forEach((figure) => {
    const key = figure.dataset.diagram;
    if (key === 'flowchart') return;
    const flowDefinition = flowDefinitions[key];
    if (flowDefinition) {
      figure.classList.add('flow-diagram', 'mermaid-flowchart');
      figure.dataset.nodeCount = String(flowDefinition.nodes);
      figure.dataset.mermaid = flowDefinition.source;
      figure.setAttribute('role', 'img');
      figure.setAttribute('aria-label', figure.dataset.label || flowAriaLabels[key] || key.replaceAll('-', ' '));
      figure.replaceChildren();
      return;
    }
    const template = templates[key];
    if (!template) return;
    const stage = document.createElement('div');
    stage.className = `diagram-stage diagram-${key}`;
    stage.innerHTML = template;
    figure.replaceChildren(stage);
    figure.setAttribute('role', 'img');
    figure.setAttribute('aria-label', figure.dataset.label || key.replaceAll('-', ' '));
    figure.dataset.rendered = 'true';
  });
</script>

<script>
  import katex from 'katex';

  const flowcharts = [...document.querySelectorAll<HTMLElement>('.mermaid-flowchart[data-mermaid]')];
  if (flowcharts.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      flowchart: { curve: 'basis', htmlLabels: true, nodeSpacing: 42, rankSpacing: 58, useMaxWidth: true },
      themeVariables: {
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
        fontSize: '15px',
        lineColor: '#46765f',
        edgeLabelBackground: '#f3f3ed',
        clusterBkg: 'transparent',
        clusterBorder: 'transparent',
      },
    });
    for (const [index, flowchart] of flowcharts.entries()) {
      const source = flowchart.dataset.mermaid;
      if (!source) continue;
      try {
        const { svg, bindFunctions } = await mermaid.render(`mermaid-flowchart-${index}`, source);
        flowchart.innerHTML = svg;
        const visual = flowchart.querySelector('svg');
        visual?.setAttribute('aria-hidden', 'true');
        visual?.setAttribute('focusable', 'false');
        bindFunctions?.(flowchart);
        flowchart.dataset.rendered = 'true';
      } catch (error) {
        flowchart.dataset.mermaidError = 'true';
        console.error('Unable to render Mermaid flowchart', error);
      }
    }
  }

  document.querySelectorAll<HTMLElement>('.figure-equation[data-math]').forEach((equation) => {
    const formula = equation.dataset.math;
    if (!formula) return;
    try {
      katex.render(formula, equation, {
        displayMode: true,
        throwOnError: false,
        strict: 'ignore',
      });
    } catch {
      // Preserve the accessible text supplied by the generated content if a
      // malformed upstream formula cannot be rendered.
      equation.textContent = equation.getAttribute('aria-label') || formula;
    }
  });

  const matrixEnvironment = /\\begin\{(?:[bpvVB]?matrix|smallmatrix|array)\}/;
  const fitMatrixDisplays = () => {
    document.querySelectorAll<HTMLElement>('.katex-display').forEach((display) => {
      const formula = display.querySelector('annotation[encoding="application/x-tex"]')?.textContent || '';
      if (!matrixEnvironment.test(formula)) return;

      display.style.removeProperty('font-size');
      display.removeAttribute('data-matrix-fit');
      const renderedFormula = display.querySelector<HTMLElement>(':scope > .katex');
      if (!renderedFormula || display.clientWidth === 0) return;

      const availableWidth = display.clientWidth - 4;
      const requiredWidth = renderedFormula.scrollWidth;
      if (requiredWidth <= availableWidth) {
        display.dataset.matrixFit = 'natural';
        return;
      }

      const baseSize = Number.parseFloat(getComputedStyle(display).fontSize);
      const scale = Math.max(0.68, availableWidth / requiredWidth);
      display.style.fontSize = `${baseSize * scale}px`;
      display.dataset.matrixFit = scale > 0.68 ? 'scaled' : 'scroll';
    });
  };

  let matrixFitFrame = 0;
  const scheduleMatrixFit = () => {
    cancelAnimationFrame(matrixFitFrame);
    matrixFitFrame = requestAnimationFrame(fitMatrixDisplays);
  };
  scheduleMatrixFit();
  document.fonts?.ready.then(scheduleMatrixFit);
  window.addEventListener('resize', scheduleMatrixFit, { passive: true });
</script>
