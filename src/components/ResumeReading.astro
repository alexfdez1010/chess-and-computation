---
import type { ChapterEntry, Language } from './content';
const { lang, entries } = Astro.props as { lang: Language; entries: ChapterEntry[] };
const choices = entries.map(({ slug, title, sectionTitle }) => ({ slug, title: sectionTitle || title }));
---
<div class="resume-reading" data-resume-reading data-lang={lang} data-entries={JSON.stringify(choices)} hidden>
  <a class="resume-link">
    <span class="resume-label">{lang === 'es' ? 'Continuar leyendo' : 'Continue reading'}</span>
    <span class="resume-title"></span>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
  </a>
</div>

<script>
  import { getLastVisited, syncReadingMarkers } from '../lib/reading-state';
  import type { Language } from './content';

  const resume = document.querySelector<HTMLElement>('[data-resume-reading]');
  if (resume) {
    const lang = resume.dataset.lang as Language;
    const entries = JSON.parse(resume.dataset.entries || '[]') as { slug: string; title: string }[];
    const showResume = () => {
      const slug = getLastVisited(lang, entries.map((entry) => entry.slug));
      const entry = entries.find((item) => item.slug === slug);
      const link = resume.querySelector<HTMLAnchorElement>('a');
      const title = resume.querySelector<HTMLElement>('.resume-title');
      if (entry && link && title) {
        link.href = `/${lang}/${entry.slug}`;
        title.textContent = entry.title;
        resume.hidden = false;
      } else resume.hidden = true;
    };
    showResume();
    window.addEventListener('storage', showResume);
    window.addEventListener('pageshow', showResume);
  }
  syncReadingMarkers();
</script>
