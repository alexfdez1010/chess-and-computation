<script>
  // Content stays visible without JavaScript or before the observer runs.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        // Do not animate a link while someone is navigating with the keyboard.
        if (!entry.target.contains(document.activeElement)) {
          entry.target.classList.add('motion-enter');
        }
        observer.unobserve(entry.target);
      }
    }, { threshold: 0, rootMargin: '0px 0px -24px 0px' });

    document.querySelectorAll('.home-outline > .outline-group, .chapter-pagination').forEach((element) => {
      observer.observe(element);
    });

    // Stop pending reveals if the preference changes during this visit.
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) observer.disconnect();
    });
  }
</script>
